<div style="padding:40px;">
  <h2>{{ section.settings.heading }}</h2>
  {{ product.featured_image | image_url: width: 300 | image_tag }}
  <h2>{{ product.title | upcase }}</h2>
  <p>Price: {{ product.price | money }}</p>
  <p>old price: {{ product.compare_at_price | money }}</p>
  <p>vendor: {{ product.vendor }}</p>
</div>

<div style="padding:40px;">
  {% if product.available %}
    <p>in stock</p>
    {% else %}
        <p>Sold out</p>
  {% endif %}

  <p>{{ product.price | money}}</p>
  {% if product.compare_at_price > product.price  %}

    <p><s>{{ product.compare_at_price | money }}</s></p>
      
        {%  assign saving = product.compare_at_price | minus: product.price %}
        {% assign percent = saving | times: 100 | didivided_by:  product.compare_at_price%}
    <span>{{ saving | money }}</span>
    
  {% endif %}
</div>
{% schema %}
{
  "name": "Practice",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "hello"
    }
  ],
  "presets": [
    {
      "name": "Practice"
    }
  ]
}
{% endschema %}
