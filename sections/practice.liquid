{% comment %}
  <div>
    <h2>
      {{ section.settings.heading }}
    </h2>
    {% comment %} {% assign message = 'Hello from section' %} {% endcomment %}
    {% comment %} {% render 'practice-card', message: message %} {% endcomment %}
    {% comment %} <p>collection name: {{ section.settings.my_collection.title }}</p> {% endcomment %}
    <div style="display:grid; grid-template-columns:repeat(4, 1fr); gap:16px;">
      {% for item in section.settings.my_collection.products limit: 8 %}
        {% comment %} <p>{{ forloop.index }}. {{ item.title }}</p> {% endcomment %}
        {% render 'practice-card', product: item %}
      {% else %}
        <p>No products found. Please choose a collection.</p>
      {% endfor %}
    </div>
  </div>
{% endcomment %}

{% comment %}
   <div style="padding:40px;">
    <h2>{{ section.settings.heading }}</h2>
     {{ product.featured_image | image_url: width: 300 | image_tag }}
    <h2>{{ product.title | upcase }}</h2>
    <p>Price: {{ product.price | money }}</p>
    <p>old price: {{ product.compare_at_price | money }}</p>
    <p>vendor: {{ product.vendor }}</p>
  </div>

    <div style="padding:40px;">
    {% if product.available %}
      <p>in stock</p>
    {% else %}
      <p>Sold out</p>
    {% endif %}

    <p>{{ product.price | money }}</p>
    {% if product.compare_at_price > product.price %}
      <p>
        <s>{{ product.compare_at_price | money }}</s>
      </p>

      {% assign saving = product.compare_at_price | minus: product.price %}
      {% assign percent = saving | times: 100.0 | divided_by: product.compare_at_price %}
      <span>save {{ percent | round: 1 }}%</span>
    {% endif %}
    {% if product.tags contains 'bestseller' %}
      <p>Bestsellers</p>
    {% else %}
      <p>General</p>
    {% endif %}

    <h3>All Images</h3>
    {% for image in product.images %}
      {% if forloop.first %}
        {{ image | image_url: width: 400 | image_tag }}
      {% else %}
        {{ image | image_url: width: 100 | image_tag }}
      {% endif %}
    {% endfor %}

    <h3>All variant</h3>
    {% for variant in product.variants %}
      <p>{{ variant.title }}</p>
    {% endfor %}

    {% for variant in product.variants %}
      <p>
        {{ variant.title }} - {{ variant.price | money }}
        {% unless variant.available %}
          (sold out)
        {% endunless %}
      </p>
    {% endfor %}

    <p>total images: {{ product.images.size }}</p>
    <p>total variants: {{ product.variants.size }}</p>

    <p>
      Tags:
      {% for tag in product.tags %}
        {{ tag -}}
        {%- unless forloop.last %},{% endunless %}
      {% endfor %}
    </p>

    {% for variant in product.variants %}
      <p>{{ forloop.index }}.{{ variant.title }}</p>
    {% endfor %}
  </div>
{% endcomment %}
{% comment %}
  {% schema %}
  {
    "name": "Practice",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "hello"
      },
      {
        "type": "collection",
        "id": "my_collection",
        "label": "choose collection"
      }
    ],
    "presets": [
      {
        "name": "Practice"
      }
    ]
  }
  {% endschema %}
{% endcomment %}

<div style="padding-top:40px;">
  <h2>{{ section.settings.heading }}</h2>
    {% comment %} <div>
      {{ section.settings.collection_1.title }}
    </div> {% endcomment %}
    <div>
    <div style="display:grid; ">
      {% for item in section.settings.collection_1.products limit:8 %}
      {% render 'product_card', product : item %}
      {% else %}
        <p>No Product found, Choose collection</p>
    {% endfor %}
    </div>
</div>

{% schema %}
{
  "name": "practice",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collection"
    },
    {
      "type" : "collection",
      "id" : "collection_1",
      "label" : "Choose Collection"
    }
  ],
  "presets": [
    {
      "name": "My Featured Collection"
    }
  ]
}
{% endschema %}
