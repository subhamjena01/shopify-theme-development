<div style="padding:40px;">
  <h2>My Practice area</h2>
  <h2>{{ product.title }}</h2>
    <p>{{ product.price | money }}</p>
    <p>vendor: {{ product.vendor}}</p>
    <p>type: {{ product.type }}</p>
    <p>Old price: {{ product.compare_at_price }}</p>
    <p>Available: {{ product.available }}</p>
    <p>Link:{{ product.url }}</p>
    {{ product.featured_image | image_url: width: 400, height: 400 | image_tag }}

</div>
{% schema %}
{
    "name": "Practice",
    "presets": [
    {
        "name": "Practice"
    }
    ],
    "settings":[
    {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "hello"
        
    }
    ]

}
{% endschema %}