{% assign featured_collection = section.settings.collection %}
<div class="home_featured page-width" style="padding-top:40px;">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}
</div>

<div
  class="page-width"
  style="display:grid; grid-template-columns: repeat({{ section.settings.columns }}, 1fr); gap:20px; "
>
  {%- for product in featured_collection.products limit: section.settings.product_count -%}
    <a href="{{ product.url }}">
      {{
        product.featured_image
        | image_url: width: 250, height: 250
        | image_tag: alt: product.title, style: 'object-fit:cover;'
      }}
      <h3>{{ product.title | truncate: 40 }}</h3>
      <p>
        {% if section.settings.show_sale_badge and product.compare_at_price > product.price %}
          
          <span style= "background-color: #000000; color: #ffffff;">sale</span>
          <s>{{ product.compare_at_price | money }}</s>
        {% endif %}
        {{ product.price | money }}
      </p>
    </a>
    {% else %}
        <p>Please choose a collection in the theme editor.</p>
  {% endfor %}
</div>
{% if collection != blank %}
    <a href="{{ collection.url }}"> View All {{ collection.products_count }} Products</a>
        {% endif %}
{% schema %}
{
  "name": "home featured",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Product"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose Collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Number of Product",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Product per row",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
        "type": "checkbox",
        "id": "show_sale_badge",
        "label": "Show Sale Badge",
        "default": true
    }
  ],
  "presets": [
    {
      "name": "Home Featured"
    }
  ]
}
{% endschema %}
