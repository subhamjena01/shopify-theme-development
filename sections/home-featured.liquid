{% assign collection = section.settings.collection %}
<div class="home_featured page-width" style="padding-top:40px;">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}
</div>
<div class="page-width">
  {% for product in collection.products limit: section.settings.product_count %}
    <a href="{{ product.url }}">
      {{ product.featured_image | image_url: width: 500 | image_tag: alt: product.title }}
      <h3>{{ product.title | truncate:40 }}</h3>
    </a>
    <p>{% if product.compare_at_price > product.price %}
        <s>{{ product.compare_at_price | money}}</s>
    {% endif %}
    {{ product.price | money }}
    </p>
  {% endfor %}


</div>
{% schema %}
{
  "name": "home featured",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Product"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose Collection"
    },
    {
        "type": "range",
        "id": "product_count",
        "label": "Number of Product",
        "min": 2, 
        "max": 8,
        "default": 4 
    },
    {
        "type": "select",
        "id": "columns",
        "label": "Product per row",
        "options": [
            {"value": "2", "label": "2"},
            {"value": "3", "label": "3"},
            {"value": "4", "label": "4"}
        ],
        "default": "4"
    }
  ],
  "presets": [
    {
      "name": "Home Featured"
    }
  ]
}
{% endschema %}
