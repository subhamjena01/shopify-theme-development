{% comment %} <p>Message: {{ message }}</p>
<div style="border:1px solid #ddd; padding:16px;">

  {{ product.featured_image | image_url: width: 400 | image_tag: style: 'width:100%; aspect-ratio:1/1; object-fit:contain;' }}

  <h3>{{ product.title }}</h3>

  <p>{{ product.price | money }}</p>

  {% if product.compare_at_price > product.price %}
    <p><s>{{ product.compare_at_price | money }}</s></p>
  {% endif %}

  {% unless product.available %}
    <p>Sold out</p>
  {% endunless %}

</div> {% endcomment %}

<div style="background:#efefef;">
  {{ product.featured_image | image_url: width: 400 | image_tag: style:'width:100%;' }}
  <h3>{{ product.title }}</h3>
  <p>{{ product.price | money_with_currency}}</p>
  {% if product.compare_at_price > product.price %}
    <s>{{ product.compare_at_price | money_with_currency }}</s>
  {% endif %}

</div>