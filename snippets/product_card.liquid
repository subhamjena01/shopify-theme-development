{% comment %}
  <p>Message: {{ message }}</p>
  <div style="border:1px solid #ddd; padding:16px;">

    {{ product.featured_image | image_url: width: 400 | image_tag: style: 'width:100%; aspect-ratio:1/1; object-fit:contain;' }}

    <h3>{{ product.title }}</h3>

    <p>{{ product.price | money }}</p>

    {% if product.compare_at_price > product.price %}
      <p><s>{{ product.compare_at_price | money }}</s></p>
    {% endif %}

    {% unless product.available %}
      <p>Sold out</p>
    {% endunless %}

  </div>
{% endcomment %}

{% comment %}
  <div style="background:#efefef;">
    {{ product.featured_image | image_url: width: 600 | image_tag: style:'width:100%; object-fit:cover; aspect-ratio:1/1;' }}
    <h3>{{ product.title }}</h3>
    <p>{{ product.price | money_with_currency}}</p>
    {% if product.compare_at_price > product.price %}
      <s>{{ product.compare_at_price | money_with_currency }}</s>
    {% endif %}

  </div>
{% endcomment %}

<a href="{{ product.url }}">
  {{
    product.featured_image
    | image_url: width: 250, height: 250
    | image_tag: alt: product.title, style: 'object-fit:cover;'
  }}
  <h3>{{ product.title | truncate: 40 }}</h3>
  <p>
    {% if product.compare_at_price > product.price %}
      <s>{{ product.compare_at_price | money }}</s>
    {% endif %}
    {{ product.price | money }}
  </p>
</a>
